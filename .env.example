# ============================================================
# PaytarAI — Environment Variables Template
# Kopyalayın: cp .env.example .env  →  Değerleri doldurun.
# ============================================================

# ----- Anthropic (Claude Sonnet / Haiku) -----
ANTHROPIC_API_KEY=

# ----- OpenAI (Whisper STT + text-embedding-3-small) -----
OPENAI_API_KEY=

# ----- Groq (Llama 3.3 70B Instruct — Summarization) -----
GROQ_API_KEY=

# ----- AssemblyAI (Medical Mode Fallback STT) -----
ASSEMBLYAI_API_KEY=

# ----- Qdrant Cloud -----
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=paytar_veterinary

# ----- SQLite (Audit Log & Session) -----
DATABASE_URL=sqlite:///./paytar.db

# ----- Backend -----
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000

# ----- Frontend (Next.js) -----
NEXT_PUBLIC_API_URL=http://localhost:8000
